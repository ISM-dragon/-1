# Copy this file to gateway/.env.production on the persistent host. Never commit the copied file.
PROVIDER_MODE=live
REQUIRE_GATEWAY_TOKEN=true
GATEWAY_TOKEN=replace-with-a-long-random-token
GEMINI_API_KEY=replace-with-a-server-side-gemini-key
GEMINI_MODEL=gemini-flash-latest

# Public HTTPS URL terminated by the reverse proxy, not the local container port.
PUBLIC_BASE_URL=https://gateway.example.com
CORS_ORIGINS=https://your-opus-web.manus.space

ISM_GATEWAY_DB=/data/gateway.db
ISM_PROCESSING_ROOT=/data/processing
ISM_SOURCE_ROOT=/data/sources
ISM_PIPELINE_DIR=/srv/opus/pipeline
MAX_ACTIVE_PROCESSING_JOBS=1
MAX_ACTIVE_SOURCE_JOBS=1
MIN_FREE_DISK_GB=8
