# Local development defaults
PROVIDER_MODE=mock
GATEWAY_TOKEN=
ISM_GATEWAY_DB=./gateway.db
PUBLISH_INTERVAL_SECONDS=30
ACCOUNT_DAILY_LIMIT=10
ACCOUNT_MIN_GAP_SECONDS=60
MAX_PROVIDER_ATTEMPTS=3
MAX_ACTIVE_PROCESSING_JOBS=1
MAX_ACTIVE_SOURCE_JOBS=2
MIN_FREE_DISK_GB=2
PUBLIC_BASE_URL=http://127.0.0.1:8787
GEMINI_MODEL=gemini-flash-latest
# Prefer a file readable only by the Gateway user; never commit its contents.
ISM_GEMINI_KEY_FILE=./secrets/gemini.key
# Optional JSON fallback vault; environment variables remain preferred and secrets/ is gitignored.
ISM_AI_SECRET_FILE=./secrets/ai-vault.json
# Remote Android processing. Set these on the server that has the pipeline folder.
ISM_PROCESSING_ROOT=./processing
ISM_PIPELINE_DIR=../pipeline
ISM_YTDLP_BIN=yt-dlp
ISM_SOURCE_ROOT=./sources
# Optional: absolute command prefix; otherwise uv or the current Python is detected.
# ISM_PIPELINE_BIN=/usr/local/bin/publikclip
CORS_ORIGINS=http://localhost:1430,http://tauri.localhost,tauri://localhost

# Production requirements
# PROVIDER_MODE=live
# GATEWAY_TOKEN=generate-a-long-random-token
# CORS_ORIGINS=https://your-dashboard.example
# Use HTTPS and store provider OAuth secrets in the server secret manager.
# META_CLIENT_ID=
# META_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
